// Prisma schema — Afelandra (gestión de zapatería)
// Ver plan en C:\Users\Usuario\.claude\plans\graceful-mapping-dewdrop.md

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Catálogo / inventario ----------

model Producto {
  id         String   @id @default(cuid())
  nombre     String
  tipo       String
  color      String
  marca      String
  proveedorId String?
  proveedor  Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  talle      String   @default("") // "" = Único
  costo      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  stockMin   Int      @default(2)
  codigo     String?  @unique
  observaciones String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ventas     Venta[]
  cambiosDevueltos Cambio[] @relation("CambioDevuelto")
  cambiosNuevos    Cambio[] @relation("CambioNuevo")
  remitoItems      RemitoItem[]

  @@index([proveedorId])
  @@index([nombre])
}

// ---------- Ventas ----------

model Venta {
  id            String   @id @default(cuid())
  fecha         DateTime
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id])
  // snapshot histórico: no cambia si luego se edita el producto
  nombre        String
  tipo          String
  proveedor     String?
  talle         String
  cantidad      Int
  medioPago     String
  vendedor      String
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteNombre String?  // cliente ocasional no registrado
  observaciones String?
  sucursal      String?
  precioVenta   Decimal  @db.Decimal(12, 2) // unitario, ya con la promoción aplicada
  costoUnitario Decimal  @db.Decimal(12, 2) // snapshot del costo al momento de vender
  promocionId     String?
  promocion       Promocion? @relation(fields: [promocionId], references: [id], onDelete: SetNull)
  promocionNombre String?  // snapshot histórico: no cambia si luego se edita/borra la promoción
  createdAt     DateTime @default(now())

  pagos         PagoVenta[]
  cambio        Cambio?

  @@index([productoId])
  @@index([clienteId])
  @@index([promocionId])
  @@index([fecha])
}

// ---------- Promociones ----------

model Promocion {
  id              String    @id @default(cuid())
  nombre          String
  tipo            String    // "porcentaje" | "2x1"
  valorPorcentaje Decimal?  @db.Decimal(5, 2) // solo si tipo = "porcentaje"
  fechaDesde      DateTime?
  fechaHasta      DateTime?
  activa          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ventas          Venta[]
}

model PagoVenta {
  id            String       @id @default(cuid())
  ventaId       String
  venta         Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  medio         String
  monto         Decimal      @db.Decimal(12, 2)
  voucherId     String?
  voucher       Voucher?     @relation(fields: [voucherId], references: [id])
  notaCreditoId String?
  notaCredito   NotaCredito? @relation(fields: [notaCreditoId], references: [id])

  @@index([ventaId])
  @@index([voucherId])
  @@index([notaCreditoId])
}

// ---------- Vouchers (ingreso sin producto asociado, redimible después) ----------

model Voucher {
  id            String   @id @default(cuid())
  codigo        String   @unique
  montoInicial  Decimal  @db.Decimal(12, 2)
  saldo         Decimal  @db.Decimal(12, 2)
  medioPago     String   // cómo se cobró el voucher al venderlo (esto sí suma al cierre de caja ese día)
  vendedor      String
  clienteNombre String?
  observaciones String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())

  pagos         PagoVenta[]

  @@index([codigo])
  @@index([fecha])
}

// ---------- Cambios (devolución + producto nuevo) y Notas de Crédito ----------

model Cambio {
  id                 String   @id @default(cuid())
  fecha              DateTime @default(now())
  clienteId          String
  cliente            Cliente  @relation(fields: [clienteId], references: [id])

  productoDevueltoId String
  productoDevuelto   Producto @relation("CambioDevuelto", fields: [productoDevueltoId], references: [id])
  nombreDevuelto     String
  talleDevuelto      String
  precioDevuelto     Decimal  @db.Decimal(12, 2)

  productoNuevoId    String
  productoNuevo      Producto @relation("CambioNuevo", fields: [productoNuevoId], references: [id])
  nombreNuevo        String
  talleNuevo         String
  precioNuevo        Decimal  @db.Decimal(12, 2)

  diferencia         Decimal  @db.Decimal(12, 2) // precioNuevo - precioDevuelto
  medioPago          String   // medio usado para tasar ambos productos del cambio

  ventaId            String?      @unique
  venta              Venta?       @relation(fields: [ventaId], references: [id])
  notaCreditoId      String?      @unique
  notaCredito        NotaCredito? @relation(fields: [notaCreditoId], references: [id])

  vendedor           String
  observaciones      String?
  createdAt          DateTime @default(now())

  @@index([clienteId])
  @@index([fecha])
}

model NotaCredito {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  montoInicial  Decimal  @db.Decimal(12, 2)
  saldo         Decimal  @db.Decimal(12, 2)
  medioPago     String   // medio de referencia (del cambio que la generó) para tasar su redención por costo
  vendedor      String
  observaciones String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())

  cambio        Cambio?
  pagos         PagoVenta[]

  @@index([clienteId])
  @@index([fecha])
}

// ---------- Gastos ----------

model Gasto {
  id        String   @id @default(cuid())
  fecha     DateTime @default(now())
  concepto  String
  tipo      String   // "fijo" | "variable"
  monto     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([fecha])
}

// ---------- Proveedores ----------

model Proveedor {
  id            String   @id @default(cuid())
  nombre        String   @unique
  marca         String?
  contacto      String?
  formaPago     String?
  plazo         String?
  ultimaCompra  DateTime?
  deudaInicial  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productos     Producto[]
  remitos       Remito[]
  pagos         PagoProveedor[]
}

model Remito {
  id           String    @id @default(cuid())
  proveedorId  String
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id])
  fecha        DateTime
  numero       String?
  montoSinIva  Decimal   @db.Decimal(12, 2)
  tieneIva     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  items        RemitoItem[]

  @@index([proveedorId])
}

/** Detalle de artículos de un remito puntual: qué producto, talle, cantidad y costo llegó. */
model RemitoItem {
  id            String    @id @default(cuid())
  remitoId      String
  remito        Remito    @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  productoId    String?
  producto      Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  // snapshot histórico: no cambia si luego se edita/borra el producto
  nombre        String
  color         String
  talle         String
  cantidad      Int
  costoUnitario Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())

  @@index([remitoId])
  @@index([productoId])
}

model PagoProveedor {
  id          String    @id @default(cuid())
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  fecha       DateTime
  monto       Decimal   @db.Decimal(12, 2)
  medio       String    // Efectivo | Transferencia | Cheque | Depósito
  nota        String?
  createdAt   DateTime  @default(now())

  @@index([proveedorId])
}

// ---------- Clientes ----------

model Cliente {
  id        String    @id @default(cuid())
  nombre    String
  dni       String?
  email     String?
  telefono  String?
  instagram String?
  cumple    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ventas    Venta[]
  cambios      Cambio[]
  notasCredito NotaCredito[]
}

// ---------- Configuración global (fila única) ----------

model Config {
  id                 Int      @id @default(1)
  debito             Decimal  @default(2.20) @db.Decimal(6, 2)
  credito3           Decimal  @default(2.42) @db.Decimal(6, 2)
  credito6           Decimal  @default(2.82) @db.Decimal(6, 2)
  contado            Decimal  @default(10)   @db.Decimal(6, 2) // % descuento efectivo
  pinAdminHash       String?
  pinVendedorHash    String?
  preguntaAdmin         String?
  respuestaAdminHash    String?
  preguntaVendedor      String?
  respuestaVendedorHash String?
  talles             String[] @default(["35","36","37","38","39","40","41"])
  tallesIndumentaria String[] @default(["S","M","L","XL","XXL","XXXL"])
  tallesJeans        String[] @default(["34","36","38","40","42","44","46","48","50"])
  tiposCalzado       String[] @default(["Zueco","Bota","Borcego","Zapatilla","Sandalia","Botineta","Acordonado","Mocasín","Estileto","Texana"])
  tiposAccesorio     String[] @default(["Cartera","Bandolera","Billetera","Indumentaria","Cintos"])
  vendedores         String[] @default([])
  updatedAt          DateTime @updatedAt
}

/** Coeficientes propios por marca; si una marca no tiene fila acá, se usan los de Config. */
model CoeficienteMarca {
  id        String   @id @default(cuid())
  marca     String   @unique
  debito    Decimal  @db.Decimal(6, 2)
  credito3  Decimal  @db.Decimal(6, 2)
  credito6  Decimal  @db.Decimal(6, 2)
  contado   Decimal  @db.Decimal(6, 2)
  updatedAt DateTime @updatedAt
}
